BIODSH_ENVIRONMENT=development
BIODSH_DATABASE_URL=postgresql+psycopg://biodsh:biodsh@127.0.0.1:5432/biodsh
BIODSH_PLATFORM_TOKEN=replace-with-a-long-random-token
BIODSH_JWT_SECRET=replace-with-an-independent-32-character-random-secret
BIODSH_JWT_ISSUER=biodsh-platform
BIODSH_JWT_AUDIENCE=biodsh-desktop
BIODSH_ACCESS_TOKEN_MINUTES=15
BIODSH_REFRESH_TOKEN_DAYS=30
BIODSH_LOGIN_MAX_ATTEMPTS=5
BIODSH_LOGIN_LOCK_MINUTES=15
BIODSH_NODE_OFFLINE_SECONDS=45
BIODSH_METRICS_RETENTION_DAYS=7
BIODSH_JOB_LEASE_SECONDS=45
BIODSH_ARTIFACT_ROOT=./biodsh-artifacts
BIODSH_ARTIFACT_MAX_BYTES=1073741824
BIODSH_AUTO_CREATE_SCHEMA=false
BIODSH_SERVICE_NAME=biodsh-platform-dev
BIODSH_HOST=127.0.0.1
BIODSH_PORT=8000
BIODSH_API_PREFIX=/api/v1
BIODSH_LOG_LEVEL=debug
BIODSH_DOCS_ENABLED=true
BIODSH_CORS_ORIGINS=["tauri://localhost","http://localhost:5173"]
BIODSH_DATABASE_POOL_SIZE=5
BIODSH_DATABASE_MAX_OVERFLOW=5
