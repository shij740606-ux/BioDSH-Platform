POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=biodsh
POSTGRES_USER=biodsh
POSTGRES_PASSWORD=replace-with-a-strong-database-password
BIODSH_DATABASE_URL=postgresql+psycopg://biodsh:replace-with-url-encoded-password@postgres:5432/biodsh
BIODSH_SERVICE_NAME=biodsh-platform
BIODSH_PLATFORM_TOKEN=replace-with-a-long-random-platform-token
BIODSH_PLATFORM_BIND=127.0.0.1:8000
BIODSH_CONTAINER_PORT=8000
BIODSH_API_PREFIX=/api/v1
BIODSH_LOG_LEVEL=info
BIODSH_DOCS_ENABLED=false
BIODSH_CORS_ORIGINS=["tauri://localhost"]
BIODSH_DATABASE_POOL_SIZE=10
BIODSH_DATABASE_MAX_OVERFLOW=20
