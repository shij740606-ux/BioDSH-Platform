BIODSH_WORKER_PLATFORM_URL=https://platform.example.org
BIODSH_WORKER_NODE_NAME=compute-01
BIODSH_WORKER_CREDENTIAL_FILE=/var/lib/biodsh/worker.json
BIODSH_WORKER_METRIC_PATH=/data
BIODSH_WORKER_HEARTBEAT_SECONDS=10
BIODSH_WORKER_REQUEST_TIMEOUT_SECONDS=15

# Set only while running `biodsh-worker enroll`, then remove it from this file.
BIODSH_WORKER_BOOTSTRAP_TOKEN=replace-with-platform-bootstrap-token
