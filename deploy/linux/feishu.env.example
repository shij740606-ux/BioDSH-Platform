# Copy into the platform environment, not the desktop app.
BIODSH_FEISHU_LOGIN_ENABLED=true
BIODSH_PUBLIC_BASE_URL=https://platform.example.org
BIODSH_FEISHU_APP_ID=cli_replace_me
BIODSH_FEISHU_APP_SECRET=replace_me
BIODSH_FEISHU_REDIRECT_URI=https://platform.example.org/api/v1/auth/feishu/callback
BIODSH_FEISHU_ALLOWED_TENANTS=["replace_with_your_tenant_key"]
BIODSH_PROJECT_NODE_AUTHORIZATION_ENABLED=true
BIODSH_FEISHU_NOTIFICATIONS_ENABLED=true
